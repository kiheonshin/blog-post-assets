{
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/series/went-in-first/(.*)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/series/where-worlds-meet/(.*)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/series/handed-down/(.*)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/previews/(.*)",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/universe/:view(ontology|graph|identity|map)/:file+",
      "destination": "https://kiheon-life-universe-observatory.vercel.app/:file+"
    },
    {
      "source": "/universe/:view(ontology|graph|identity|map)/",
      "destination": "https://kiheon-life-universe-observatory.vercel.app/:view"
    },
    {
      "source": "/universe/",
      "destination": "https://kiheon-life-universe-observatory.vercel.app/map"
    },
    {
      "source": "/universe/:path*",
      "destination": "https://kiheon-life-universe-observatory.vercel.app/:path*"
    },
    {
      "source": "/notes/",
      "destination": "https://kiheon-life-universe-notes.vercel.app/"
    },
    {
      "source": "/notes/:path+/",
      "destination": "https://kiheon-life-universe-notes.vercel.app/:path+/"
    },
    {
      "source": "/notes/:path*",
      "destination": "https://kiheon-life-universe-notes.vercel.app/:path*"
    }
  ],
  "headers": [
    {
      "source": "/((?!universe/).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.googletagmanager.com https://www.google-analytics.com; font-src 'self'; media-src 'self'; connect-src 'self' https://blog-post-assets.vercel.app wss://api.x.ai https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://www.google.com https://www.googletagmanager.com; frame-src 'self' https://www.youtube-nocookie.com; object-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self' https://kiheon.app; upgrade-insecure-requests"
        }
      ]
    }
  ]
}
